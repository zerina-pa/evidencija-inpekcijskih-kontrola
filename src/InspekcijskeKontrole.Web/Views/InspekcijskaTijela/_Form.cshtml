@model InspekcijskeKontrole.Web.ViewModels.InspekcijskoTijeloFormModel

<div class="mb-3">
    <label asp-for="Naziv" class="form-label"></label>
    <input asp-for="Naziv" class="form-control" />
    <span asp-validation-for="Naziv" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Inspektorat" class="form-label"></label>
    <select asp-for="Inspektorat"
            asp-items="Html.GetEnumSelectList<Inspektorat>()"
            class="form-select">
        <option value="">Izaberite inspektorat</option>
    </select>
    <span asp-validation-for="Inspektorat" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Nadleznost" class="form-label"></label>
    <select asp-for="Nadleznost"
            asp-items="Html.GetEnumSelectList<Nadleznost>()"
            class="form-select">
        <option value="">Izaberite nadležnost</option>
    </select>
    <span asp-validation-for="Nadleznost" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="KontaktOsoba" class="form-label"></label>
    <input asp-for="KontaktOsoba" class="form-control" />
    <span asp-validation-for="KontaktOsoba" class="text-danger"></span>
</div>
