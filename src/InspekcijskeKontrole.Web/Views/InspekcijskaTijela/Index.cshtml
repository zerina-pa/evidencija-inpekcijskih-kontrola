@model IReadOnlyList<InspekcijskeKontrole.Web.Models.InspekcijskoTijelo>

@{
    ViewData["Title"] = "Inspekcijska tijela";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Inspekcijska tijela</h1>
    <a asp-action="Create" class="btn btn-primary">Novo inspekcijsko tijelo</a>
</div>

@if (TempData["Poruka"] is string poruka)
{
    <div class="alert alert-success" role="alert">@poruka</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Inspektorat</th>
                <th>Nadležnost</th>
                <th>Kontakt osoba</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var tijelo in Model)
        {
            <tr>
                <td>@tijelo.Naziv</td>
                <td>@tijelo.Inspektorat.GetDisplayName()</td>
                <td>@tijelo.Nadleznost.GetDisplayName()</td>
                <td>@tijelo.KontaktOsoba</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@tijelo.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@tijelo.Id" class="btn btn-sm btn-outline-primary">Izmijeni</a>
                    <a asp-action="Delete" asp-route-id="@tijelo.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
