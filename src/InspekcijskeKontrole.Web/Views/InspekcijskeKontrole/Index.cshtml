@model IReadOnlyList<InspekcijskeKontrole.Web.Models.InspekcijskaKontrola>

@{
    ViewData["Title"] = "Inspekcijske kontrole";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Inspekcijske kontrole</h1>
    <a asp-action="Create" class="btn btn-primary">Nova inspekcijska kontrola</a>
</div>

@if (TempData["Poruka"] is string poruka)
{
    <div class="alert alert-success" role="alert">@poruka</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Datum i vrijeme</th>
                <th>Inspekcijsko tijelo</th>
                <th>Proizvod</th>
                <th>Proizvod siguran</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var kontrola in Model)
        {
            <tr>
                <td>@kontrola.DatumKontrole.ToString("dd.MM.yyyy. HH:mm")</td>
                <td>@kontrola.InspekcijskoTijelo.Naziv</td>
                <td>@kontrola.Proizvod.Naziv</td>
                <td>@(kontrola.ProizvodSiguran ? "DA" : "NE")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@kontrola.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                    <a asp-controller="Izvjestaji"
                       asp-action="Zapisnik"
                       asp-route-id="@kontrola.Id"
                       class="btn btn-sm btn-outline-dark">Zapisnik</a>
                    <a asp-action="Edit" asp-route-id="@kontrola.Id" class="btn btn-sm btn-outline-primary">Izmijeni</a>
                    <a asp-action="Delete" asp-route-id="@kontrola.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
