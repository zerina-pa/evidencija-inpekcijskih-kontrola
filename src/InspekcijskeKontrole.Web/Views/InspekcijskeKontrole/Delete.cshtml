@model InspekcijskeKontrole.Web.Models.InspekcijskaKontrola

@{
    ViewData["Title"] = "Brisanje inspekcijske kontrole";
}

<h1 class="h3 mb-3">Potvrda brisanja inspekcijske kontrole</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<dl class="row">
    <dt class="col-sm-3">Datum i vrijeme kontrole</dt>
    <dd class="col-sm-9">@Model.DatumKontrole.ToString("dd.MM.yyyy. HH:mm")</dd>

    <dt class="col-sm-3">Inspekcijsko tijelo</dt>
    <dd class="col-sm-9">@Model.InspekcijskoTijelo.Naziv</dd>

    <dt class="col-sm-3">Proizvod</dt>
    <dd class="col-sm-9">@Model.Proizvod.Naziv</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Obriši kontrolu</button>
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>
