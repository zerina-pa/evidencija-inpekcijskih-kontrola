@model InspekcijskeKontrole.Web.ViewModels.ProizvodFormModel

@{
    ViewData["Title"] = "Izmjena proizvoda";
}

<h1 class="h3 mb-3">Izmjena proizvoda</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Sačuvaj izmjene</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
