@model InspekcijskeKontrole.Web.Models.Proizvod

@{
    ViewData["Title"] = "Brisanje proizvoda";
}

<h1 class="h3 mb-3">Potvrda brisanja proizvoda</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<dl class="row">
    <dt class="col-sm-3">Naziv proizvoda</dt>
    <dd class="col-sm-9">@Model.Naziv</dd>

    <dt class="col-sm-3">Proizvođač</dt>
    <dd class="col-sm-9">@Model.Proizvodjac</dd>

    <dt class="col-sm-3">Serijski broj</dt>
    <dd class="col-sm-9">@(Model.SerijskiBroj ?? "–")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Obriši proizvod</button>
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>
