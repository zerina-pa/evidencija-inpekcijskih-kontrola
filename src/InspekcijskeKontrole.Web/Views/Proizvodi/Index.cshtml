@model IReadOnlyList<InspekcijskeKontrole.Web.Models.Proizvod>

@{
    ViewData["Title"] = "Proizvodi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Proizvodi</h1>
    <a asp-action="Create" class="btn btn-primary">Novi proizvod</a>
</div>

@if (TempData["Poruka"] is string poruka)
{
    <div class="alert alert-success" role="alert">@poruka</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <label for="pretraga" class="form-label">Pretraga po nazivu</label>
        <input id="pretraga" name="pretraga" value="@ViewBag.Pretraga" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Pretraži</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Proizvođač</th>
                <th>Serijski broj</th>
                <th>Zemlja porijekla</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var proizvod in Model)
        {
            <tr>
                <td>@proizvod.Naziv</td>
                <td>@proizvod.Proizvodjac</td>
                <td>@(proizvod.SerijskiBroj ?? "–")</td>
                <td>@proizvod.ZemljaPorijekla</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@proizvod.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@proizvod.Id" class="btn btn-sm btn-outline-primary">Izmijeni</a>
                    <a asp-action="Delete" asp-route-id="@proizvod.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
