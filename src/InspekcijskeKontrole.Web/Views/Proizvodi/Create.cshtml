@model InspekcijskeKontrole.Web.ViewModels.ProizvodFormModel

@{
    ViewData["Title"] = "Novi proizvod";
}

<h1 class="h3 mb-3">Novi proizvod</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Create" method="post" class="col-lg-8">
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Sačuvaj</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
